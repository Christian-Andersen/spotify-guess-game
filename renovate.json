{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":disableDependencyDashboard"],
  "semanticCommits": "enabled",
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Group non-major CI action updates in .forgejo/workflows; major bumps get their own PR",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "CI workflow actions",
      "groupSlug": "ci-workflow-actions"
    },
    {
      "description": "Group non-major devDependency updates; the toolchain here moves together, and the pairs that have to agree (tailwindcss with @tailwindcss/vite, @types/react with @types/react-dom) do so in one PR",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "Dev dependencies",
      "groupSlug": "dev-dependencies"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the pnpm version pinned in flake.nix permittedInsecurePackages",
      "managerFilePatterns": ["/(^|/)flake\\.nix$/"],
      "matchStrings": [
        "permittedInsecurePackages\\s*=\\s*\\[[^\\]]*\"pnpm-(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "pnpm",
      "packageNameTemplate": "pnpm",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    }
  ]
}
